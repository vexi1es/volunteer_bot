[Unit]
Description=School 21 Volunteer Bot
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=volbot
Group=volbot
WorkingDirectory=/opt/volunteer-bot
Environment=BOT_HOME=/opt/volunteer-bot
EnvironmentFile=/opt/volunteer-bot/.env
ExecStart=/opt/volunteer-bot/run.sh
Restart=always
RestartSec=10
KillSignal=SIGTERM
TimeoutStopSec=20
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/volunteer-bot
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
